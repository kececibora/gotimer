default_platform(:android)

# Yollar Fastfile konumuna gore hesaplanir (android/fastlane).
PROJECT_ROOT = File.expand_path("../..", __dir__)
AAB_PATH = File.join(PROJECT_ROOT, "build/app/outputs/bundle/release/app-release.aab")

platform :android do
  desc "Flutter ile imzali release AAB uret"
  lane :build_aab do
    Dir.chdir(PROJECT_ROOT) do
      sh("flutter", "build", "appbundle", "--release")
    end
    UI.user_error!("AAB bulunamadi: #{AAB_PATH}") unless File.exist?(AAB_PATH)
  end

  desc "Google Play'e yukle. Kullanim: fastlane deploy track:internal"
  desc "track secenekleri: internal | alpha | beta | production (varsayilan: internal)"
  lane :deploy do |options|
    track = options[:track] || "internal"
    build_aab
    upload_to_play_store(
      track: track,
      aab: AAB_PATH,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed",
    )
    UI.success("#{track} track'ine yuklendi ✅")
  end

  desc "pubspec.yaml build numarasini +1 artir (1.1.1+6 -> 1.1.1+7)"
  lane :bump_build do
    pubspec = File.join(PROJECT_ROOT, "pubspec.yaml")
    content = File.read(pubspec)
    new_content = content.sub(/^version:\s*(\d+\.\d+\.\d+)\+(\d+)\s*$/) do
      name = Regexp.last_match(1)
      build = Regexp.last_match(2).to_i + 1
      UI.message("Surum: #{name}+#{Regexp.last_match(2)} -> #{name}+#{build}")
      "version: #{name}+#{build}"
    end
    UI.user_error!("pubspec.yaml icinde 'version: X.Y.Z+N' bulunamadi") if new_content == content
    File.write(pubspec, new_content)
  end

  desc "Build numarasini artir + Play'e yukle. Kullanim: fastlane release track:production"
  lane :release do |options|
    bump_build
    deploy(options)
  end

  desc "Sadece magaza metni/gorsel/surum notlarini yukle (binary yok)"
  desc "Kullanim: fastlane metadata version:6"
  lane :metadata do |options|
    vc = options[:version] || options[:version_code]
    upload_to_play_store(
      track: "production",
      version_code: vc,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_changelogs: vc.nil?,
    )
    UI.success("Magaza bilgileri yuklendi ✅")
  end

  desc "Sadece kimlik dogrulamayi test et (yukleme yapmaz)"
  lane :validate do
    validate_play_store_json_key
    UI.success("Service-account JSON gecerli ✅")
  end
end
