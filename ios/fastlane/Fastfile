default_platform(:ios)

def asc_api_key
  # Kimlikler gitignore'lu ios/fastlane/.env dosyasından gelir (public repo!)
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path("AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8", __dir__)
  )
end

APP_VERSION = "2.2.1"

platform :ios do
  desc "Apple Distribution sertifikası + App Store profili oluştur/indir"
  lane :certs do
    api_key = asc_api_key
    get_certificates(api_key: api_key)
    get_provisioning_profile(api_key: api_key)
  end

  desc "10 dilli mağaza metinlerini App Store Connect'e yükle"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      app_version: APP_VERSION,
      skip_binary_upload: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Ekran görüntülerini App Store Connect'e yükle"
  lane :shots do
    deliver(
      api_key: asc_api_key,
      app_version: APP_VERSION,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "TestFlight'taki en son build numarasini yazdir"
  lane :build_status do
    n = latest_testflight_build_number(api_key: asc_api_key, version: APP_VERSION)
    UI.success("TestFlight #{APP_VERSION} son build: #{n}")
  end

  desc "Metinleri yükle, build'i sürüme bağla ve App Store incelemesine gönder"
  desc "Kullanım: fastlane submit build:12  (build TestFlight'ta işlenmiş olmalı)"
  lane :submit do |options|
    build = options[:build] or UI.user_error!("build numarası gerekli: fastlane submit build:12")
    deliver(
      api_key: asc_api_key,
      app_version: APP_VERSION,
      build_number: build.to_s,
      submit_for_review: true,
      automatic_release: true,
      force: true,                      # HTML önizleme sorma
      skip_binary_upload: true,         # binary zaten TestFlight'ta
      skip_screenshots: true,           # görseller değişmedi
      run_precheck_before_submit: false,
      submission_information: {
        # Info.plist'te ITSAppUsesNonExemptEncryption=false → şifreleme sorusu yok
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Hazır IPA'yı TestFlight'a yükle"
  lane :beta do
    ipa = File.expand_path("../../build/ios/ipa/gotimer.ipa", __dir__)

    # Koruma: flutter drive sonrası Generated.xcconfig test hedefinde kalabilir;
    # test koduyla derlenmiş IPA'yı ASLA yükleme (2.0.0+7 kazası).
    Dir.mktmpdir do |tmp|
      sh("unzip -o -q #{ipa.shellescape} 'Payload/Runner.app/Frameworks/App.framework/App' -d #{tmp.shellescape}")
      hits = sh(
        "strings #{tmp.shellescape}/Payload/Runner.app/Frameworks/App.framework/App | " \
        "grep -cE 'screenshot_test|IntegrationTestWidgetsFlutterBinding' || true",
        log: false
      ).strip.to_i
      UI.user_error!("IPA test koduyla derlenmiş (#{hits} iz)! 'flutter build ipa' ile yeniden derle.") if hits > 0
      UI.success("IPA temiz: test kodu izi yok ✓")
    end

    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end
end
